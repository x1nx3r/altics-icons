{
  "name": "@altics/icons",
  "version": "0.1.0",
  "description": "Tree-shakeable React icon components for Altics UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./icons/*": {
      "types": "./dist/types/icons/*.d.ts",
      "import": "./dist/esm/icons/*.js",
      "require": "./dist/cjs/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node tool/generate-icons.mjs",
    "clean": "node tool/clean.mjs",
    "build": "npm run clean && npm run generate && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "node tool/build-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tool/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "altics",
    "icons",
    "react",
    "svg",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
