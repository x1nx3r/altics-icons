{
  "name": "@altics/icons",
  "version": "0.1.0",
  "description": "Tree-shakeable React icons for UI, languages, and tech.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x1nx3r/altics-icons.git"
  },
  "homepage": "https://github.com/x1nx3r/altics-icons#readme",
  "bugs": {
    "url": "https://github.com/x1nx3r/altics-icons/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./icons/*": {
      "types": "./dist/types/icons/*.d.ts",
      "import": "./dist/esm/icons/*.js",
      "require": "./dist/cjs/icons/*.js"
    },
    "./tech": {
      "types": "./dist/types/tech/mono/index.d.ts",
      "import": "./dist/esm/tech/mono/index.js",
      "require": "./dist/cjs/tech/mono/index.js"
    },
    "./tech/color": {
      "types": "./dist/types/tech/color/index.d.ts",
      "import": "./dist/esm/tech/color/index.js",
      "require": "./dist/cjs/tech/color/index.js"
    },
    "./tech/color/*": {
      "types": "./dist/types/tech/color/*.d.ts",
      "import": "./dist/esm/tech/color/*.js",
      "require": "./dist/cjs/tech/color/*.js"
    },
    "./tech/*": {
      "types": "./dist/types/tech/mono/*.d.ts",
      "import": "./dist/esm/tech/mono/*.js",
      "require": "./dist/cjs/tech/mono/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "fetch:tech": "node tool/fetch-tech-icons.mjs",
    "generate": "node tool/generate-icons.mjs",
    "clean": "node tool/clean.mjs",
    "build": "npm run clean && npm run generate && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "node tool/build-cjs.mjs",
    "preview": "npm run build && node tool/build-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node tool/smoke-test.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "altics",
    "icons",
    "react",
    "svg",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "devicon": "^2.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "typescript": "^7.0.2"
  }
}
